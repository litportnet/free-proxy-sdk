{
  "name": "@litport/free-proxy-sdk",
  "version": "0.0.0",
  "description": "Dependency-free client and CLI for Litport's verified free proxy snapshot.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "bin": {
    "litport-free-proxies": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litportnet/free-proxy-sdk.git"
  },
  "scripts": {
    "build": "node ../../scripts/build-js.mjs",
    "test": "node --test test/*.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pretypecheck": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
