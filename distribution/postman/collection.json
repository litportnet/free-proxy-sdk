      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns success', () => pm.response.to.have.status(200));",
              "pm.test('only SOCKS5 records', () => pm.response.json().forEach(row => pm.expect(row.protocol).to.eql('socks5')));"
