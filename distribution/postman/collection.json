            ]
          }
        }
      ]
    },
    {
      "name": "TXT export",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/free-proxy?format=txt&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns success', () => pm.response.to.have.status(200));",
